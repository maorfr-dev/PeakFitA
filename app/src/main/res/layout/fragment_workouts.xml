<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/tvWorkoutsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="תוכנית אימונים"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:textColor="#FFD700" />

    <TextView
        android:id="@+id/tvWorkoutsSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בחר יום כדי לראות או לתעד אימון"
        android:textSize="16sp"
        android:layout_below="@id/tvWorkoutsTitle"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="16dp"
        android:textColor="#AAAAAA" />

    <HorizontalScrollView
        android:id="@+id/daysScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvWorkoutsSubtitle"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/daysContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"> <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDay1"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:text="א"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:gravity="center"
            app:backgroundTint="#1E1E1E"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:cornerRadius="26dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDay2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:text="ב"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                app:backgroundTint="#1E1E1E"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cornerRadius="26dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDay3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:text="ג"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                app:backgroundTint="#1E1E1E"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cornerRadius="26dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDay4"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:text="ד"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                app:backgroundTint="#1E1E1E"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cornerRadius="26dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDay5"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:text="ה"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                app:backgroundTint="#1E1E1E"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cornerRadius="26dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDay6"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:text="ו"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                app:backgroundTint="#1E1E1E"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cornerRadius="26dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDay7"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:text="ש"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:gravity="center"
                app:backgroundTint="#1E1E1E"
                app:strokeColor="#333333"
                app:strokeWidth="1dp"
                app:cornerRadius="26dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWorkouts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/daysScrollView"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/llEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:visibility="gone"> <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💪"
        android:textSize="50sp"
        android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="היום הזה עדיין ריק..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="זמן מצוין לתעד אימון חדש!"
            android:textColor="#777777"
            android:textSize="14sp"/>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddWorkout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        app:srcCompat="@android:drawable/ic_input_add"
        app:backgroundTint="#FFD700"
        app:tint="#121212"
        app:elevation="8dp" />

</RelativeLayout>