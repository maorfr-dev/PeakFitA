<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PeakForm AI Assistant"
        android:textColor="#FFD700"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="יועץ האימונים החכם שלך מבוסס Gemini"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etMuscleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="איזו קבוצת שריר תרצה לאמן? (למשל: חזה, גב)"
        android:textColorHint="#666666"
        android:textColor="#FFFFFF"
        android:inputType="text"
        android:backgroundTint="#FFD700"
        android:layout_marginBottom="16dp"
        android:padding="12dp"/>

    <Button
        android:id="@+id/btnAskGemini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="בקש המלצות לתרגילים"
        android:backgroundTint="#FFD700"
        android:textColor="#121212"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAiResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="התשובה של Gemini תופיע כאן..."
            android:textColor="#DDDDDD"
            android:textSize="16sp"
            android:lineSpacingExtra="6sp"/>
    </ScrollView>

</LinearLayout>