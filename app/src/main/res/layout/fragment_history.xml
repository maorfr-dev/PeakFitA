<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="היסטוריית אימונים"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="כל ההישגים והאימונים שלך במקום אחד"
        android:textSize="16sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTrophyCabinet"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:text="🏆 ארון הגביעים שלי"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        app:backgroundTint="#1E1E1E"
        app:strokeColor="#FFD700"
        app:strokeWidth="1.5dp"
        app:cornerRadius="16dp"
        android:layout_marginBottom="24dp"
        app:elevation="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="אימוני עבר"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoryWorkouts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="20dp" />

</LinearLayout>